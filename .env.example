# Copy to .env and fill in real values. .env is git-ignored; this file is not.
#
# All five required variables are fatal-if-missing at startup rather than defaulted:
# a proxy that silently starts without one of its account keys is a proxy that routes
# every conversation onto the remaining two and reports nothing.

# Shared bearer key clients present to this proxy. One key, no user model.
LLMUX_PROXY_KEY=replace-me

# The three upstream account keys. They must be non-empty AND distinct: duplicate
# credentials would create two limiter buckets for one real account, which is exactly
# the over-sending defect the per-account counter exists to prevent. Startup rejects it.
LLMUX_ACCOUNT_K1_KEY=replace-me
LLMUX_ACCOUNT_K2_KEY=replace-me
LLMUX_ACCOUNT_K3_KEY=replace-me

# Absolute path to the SQLite attempt log. Required, with no default, because the
# sensible default would be a relative path, and a relative path means the log lands
# wherever the process happened to be started from.
LLMUX_LOG_PATH=/replace/with/an/absolute/path/llmux.db

# Optional.
# LLMUX_LISTEN_ADDR=127.0.0.1:4000
# LLMUX_LOG_LEVEL=info
