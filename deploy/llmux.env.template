# Placeholder environment file for llmux.
# Do not commit real credentials to this file or any file in the repository.
# The actual environment file should be placed outside the repository with 0600 permissions.

# Required: The bearer token clients will send to authenticate to the proxy (min 32 bytes)
LLMUX_PROXY_KEY="PLACEHOLDER_PROXY_KEY"

# Required: Provider account keys
LLMUX_ACCOUNT_K1_KEY="PLACEHOLDER_ACCOUNT_K1_KEY"
LLMUX_ACCOUNT_K2_KEY="PLACEHOLDER_ACCOUNT_K2_KEY"
LLMUX_ACCOUNT_K3_KEY="PLACEHOLDER_ACCOUNT_K3_KEY"

# Required: HMAC key for session affinity (min 32 bytes)
LLMUX_AFFINITY_HMAC_KEY="PLACEHOLDER_AFFINITY_HMAC_KEY"

# Required: Absolute path to the SQLite database
LLMUX_DB_PATH="/opt/llmux/data/llmux.sqlite"

# Optional: Address to listen on (default: 127.0.0.1:4000)
# Must be an IPv4 loopback or ::1 literal
# LLMUX_LISTEN_ADDR="127.0.0.1:4000"

# Optional: Log level (default: info)
# LLMUX_LOG_LEVEL="info"
